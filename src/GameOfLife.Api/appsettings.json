{
  "GameOfLife": {
    "MaxRows": 256,
    "MaxColumns": 256,
    "MaxGenerationsAhead": 500,
    "MaxFinalStateGenerations": 500,
    "MaxConcurrentSimulations": 8,
    "BoardLockTimeoutSeconds": 5,
    "MaxBoardCells": 65536,
    "MaxSimulationCellSteps": 67108864,
    "MaxRetainedStateBytes": 536870912
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*"
}
